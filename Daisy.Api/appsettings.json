{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Daisy": "Server=.;Database=Daisy;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Jwt": {
    "Issuer": "Daisy.Api",
    "Audience": "Daisy.Mvc",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "PasswordReset": {
    "TokenMinutes": 30,
    "ResetUrl": "https://localhost:7002/account/reset-password"
  },
  "Checkout": {
    "ShippingFee": 30000,
    "FreeShippingThreshold": null
  },
  "VietQr": {
    "Provider": "SePay",
    "BankBin": "",
    "BankName": "",
    "AccountNumber": "",
    "AccountName": "",
    "QrTemplate": "compact2",
    "PaymentTimeoutMinutes": 30,
    "ExpiryGraceMinutes": 5
  },
  "Storage": {
    "RootPath": "../storage",
    "PublicBasePath": "/uploads",
    "MaxImageBytes": 5242880,
    "MaxAvatarBytes": 2097152,
    "MaxFilesPerUpload": 10
  },
  "Smtp": {
    "Host": "",
    "Port": 587,
    "UserName": "",
    "FromAddress": "no-reply@daisy.local",
    "FromName": "Daisy"
  },
  "RateLimits": {
    "Auth": 10,
    "Password": 5,
    "Voucher": 20
  },
  "BackgroundJobs": {
    "Enabled": true
  }
}
