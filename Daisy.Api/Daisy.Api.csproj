    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Daisy.Application\Daisy.Application.csproj" />
    <ProjectReference Include="..\Daisy.Infrastructure\Daisy.Infrastructure.csproj" />
  </ItemGroup>

