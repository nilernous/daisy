@startuml UC-56
' Use case: ../use-cases/UC-56.md
title UC-56: Cancel Order (Admin)
footer Feature AORD-04 | Business rules: BR-07, BR-35, BR-36
autonumber
hide footbox
skinparam responseMessageBelowArrow true

actor "Staff / Admin" as U
participant "Daisy.Mvc" as MVC
participant "Admin/OrdersController" as API <<Daisy.Api>>
participant "OrderService" as SVC <<Daisy.Application>>
database "DaisyDbContext" as DB <<SQL Server>>

note over API : Requires role: Staff, Admin

U -> MVC : Click "Cancel order" and enter a reason
alt reason is empty
  MVC --> U : Ask for a cancellation reason
else reason given
  MVC -> API : POST /api/admin/orders/{id}/cancel { reason }
  API -> SVC : CancelAsync(orderId, reason)
  SVC -> DB : Load order + items
  alt order not found
    SVC --> API : NotFound
    API --> MVC : 404 Not Found
    MVC --> U : Show "Order not found"
  else OrderStatus is not Pending or Confirmed (BR-36)
    SVC --> API : Conflict
    API --> MVC : 409 Conflict
    MVC --> U : Show "This order can no longer be canceled"
  else Pending or Confirmed
    group transaction
      SVC -> DB : Set OrderStatus = Canceled, CancelReason, CanceledAt
      loop each order item
        SVC -> DB : ProductVariants.StockQuantity += Quantity
        SVC -> DB : Products.SoldCount -= Quantity
      end
      opt order used a voucher
        SVC -> DB : Vouchers.UsedCount -= 1
      end
      SVC -> DB : SaveChangesAsync + COMMIT
    end
    opt PaymentStatus = Paid
      note over SVC : Staff refund the customer and\nmark the payment Refunded (UC-57)
    end
    SVC --> API : CanceledOrderDto
    API --> MVC : 200 OK
    MVC --> U : Show order as Canceled
  end
end

@enduml
