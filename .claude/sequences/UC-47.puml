@startuml UC-47
' Use case: ../use-cases/UC-47.md
title UC-47: Manage Variants
footer Feature APRD-03 | Business rules: BR-07, BR-11, BR-12, BR-17
autonumber
hide footbox
skinparam responseMessageBelowArrow true

actor "Staff / Admin" as U
participant "Daisy.Mvc" as MVC
participant "Admin/ProductsController" as API <<Daisy.Api>>
participant "ProductService" as SVC <<Daisy.Application>>
database "DaisyDbContext" as DB <<SQL Server>>

note over API : Requires role: Staff, Admin

alt Add or edit variant
  U -> MVC : Submit variant (SKU, size, color, color hex,\nextra price, stock, low-stock threshold)
  MVC -> API : POST /api/admin/products/{id}/variants\nor PUT /api/admin/variants/{variantId}
  API -> SVC : SaveVariantAsync(request)
  SVC -> DB : Check SKU unique and (ProductId, Size, Color) unique (BR-12)
  alt duplicate SKU or size/color
    SVC --> API : Conflict
    API --> MVC : 409 Conflict
    MVC --> U : Show "SKU or size/color already exists"
  else negative stock or threshold (BR-17)
    SVC --> API : BadRequest
    API --> MVC : 400 Bad Request
    MVC --> U : Show errors
  else valid
    SVC -> DB : Insert or update variant\nSaveChangesAsync
    SVC --> API : VariantDto
    API --> MVC : 200 OK / 201 Created
    MVC --> U : Show updated variant list
  end
else Hide or show variant
  U -> MVC : Toggle variant visibility
  MVC -> API : PATCH /api/admin/variants/{variantId}/visibility { isActive }
  API -> SVC : SetVariantVisibilityAsync(variantId, isActive)
  SVC -> DB : Set IsActive\nSaveChangesAsync (BR-11)
  SVC --> API : OK
  API --> MVC : 204 No Content
  MVC --> U : Show updated variant list
end

@enduml
