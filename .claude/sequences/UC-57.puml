@startuml UC-57
' Use case: ../use-cases/UC-57.md
title UC-57: Update Payment Status
footer Feature AORD-05 | Business rules: BR-07, BR-31, BR-32, BR-33, BR-34, BR-42
autonumber
hide footbox
skinparam responseMessageBelowArrow true

actor "Staff / Admin" as U
participant "Daisy.Mvc" as MVC
participant "Admin/OrdersController" as API <<Daisy.Api>>
participant "PaymentService" as SVC <<Daisy.Application>>
database "DaisyDbContext" as DB <<SQL Server>>

note over API : Requires role: Staff, Admin

U -> MVC : Choose a payment action on an order
MVC -> API : PATCH /api/admin/orders/{id}/payment\n{ action, transactionCode? }
API -> SVC : UpdatePaymentAsync(id, request)
SVC -> DB : Load order
alt action = ConfirmCod
  alt PaymentMethod = COD AND PaymentStatus = Unpaid
    SVC -> DB : Set PaymentStatus = Paid, PaidAt = now
  else otherwise
    SVC --> API : Conflict
    API --> MVC : 409 Conflict
    MVC --> U : Show "Not allowed for this order" (BR-34)
  end
else action = ConfirmTransfer (manual VietQR, BR-32)
  SVC -> DB : Any other order with this TransactionCode?
  SVC -> DB : Any PaymentTransaction with this BankReference? (BR-42)
  alt reference already recorded by the webhook
    SVC --> API : Conflict (TRANSACTION_RECORDED)
    API --> MVC : 409 Conflict
    MVC --> U : Show "Resolve this transfer in Unmatched transfers" (UC-71)
  else PaymentMethod = Online AND Unpaid AND not Canceled AND code not used
    SVC -> DB : Set PaymentStatus = Paid, PaidAt = now,\nTransactionCode = bank reference
  else otherwise
    SVC --> API : Conflict
    API --> MVC : 409 Conflict
    MVC --> U : Show "Not allowed or reference already used"
  end
else action = Refund
  alt PaymentStatus = Paid
    SVC -> DB : Set PaymentStatus = Refunded
    note right of SVC : The refund itself is made outside Daisy
  else otherwise
    SVC --> API : Conflict
    API --> MVC : 409 Conflict
    MVC --> U : Show "Only paid orders can be refunded"
  end
end
opt change allowed
  SVC -> DB : SaveChangesAsync
  SVC --> API : OK
  API --> MVC : 204 No Content
  MVC --> U : Show new payment status
end

@enduml
