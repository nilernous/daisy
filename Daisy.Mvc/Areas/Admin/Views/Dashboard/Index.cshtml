@model DashboardViewModel
@{
    (string Value, string Label)[] presets = [("7", "7 ngày"), ("30", "30 ngày"), ("90", "90 ngày"), ("year", "Từ đầu năm")];
}

<div class="admin__head">
    <div>
        <h1>Tổng quan</h1>
        <p class="muted" style="margin:0">Từ @Display.Date(Model.From) đến @Display.Date(Model.To)</p>
    </div>
</div>

<div class="presets" role="group" aria-label="Khoảng thời gian">
    @foreach (var p in presets)
    {
        <a class="chip @(Model.Preset == p.Value ? "chip--on" : "")" href="/admin?preset=@p.Value">@p.Label</a>
    }
    <form method="get" action="/admin">
        <div class="field"><label for="from">Từ ngày</label><input id="from" name="from" type="date" value="@Model.From.ToString("yyyy-MM-dd")" /></div>
        <div class="field"><label for="to">Đến ngày</label><input id="to" name="to" type="date" value="@Model.To.ToString("yyyy-MM-dd")" /></div>
        <div class="field">
            <label for="groupBy">Gộp theo</label>
            <select id="groupBy" name="groupBy">
                <option value="day" selected="@(Model.GroupBy == "day")">Ngày</option>
                <option value="month" selected="@(Model.GroupBy == "month")">Tháng</option>
            </select>
        </div>
        <button class="btn btn--ghost" type="submit">Xem</button>
    </form>
</div>

<div class="kpis">
    <div class="kpi kpi--hero"><span>Doanh thu đơn hoàn thành</span><b>@Display.Money(Model.Revenue)</b></div>
    <div class="kpi"><span>Đơn hoàn thành</span><b>@Model.CompletedOrders</b></div>
    <div class="kpi"><span>Đơn mới đặt</span><b>@Model.NewOrders</b></div>
</div>

<div class="stack" style="--stack:20px">
    <partial name="_ColumnChart" model="Model.RevenueChart" />
    <div class="cols-2">
        <partial name="_BarList" model="Model.StatusChart" />
        <partial name="_BarList" model="Model.TopProducts" />
    </div>
    <div>
        <p class="muted small" style="margin:0 0 8px">@Model.NewCustomers khách hàng mới đăng ký trong khoảng thời gian này.</p>
        <partial name="_ColumnChart" model="Model.CustomerChart" />
    </div>
</div>
