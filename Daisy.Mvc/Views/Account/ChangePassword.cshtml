@model ChangePasswordForm
@{
    if (User.IsStaffOrAdmin())
    {
        Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
    }
}

<div class="@(User.IsStaffOrAdmin() ? "" : "wrap")">
    <div class="auth" style="@(User.IsStaffOrAdmin() ? "margin:0" : "")">
        <div class="panel stack" style="--stack:20px">
            <h1 style="font-size:var(--fs-2xl);margin:0">Đổi mật khẩu</h1>
            <form method="post" action="/account/change-password" asp-antiforgery="true" class="stack" style="--stack:16px" novalidate>
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                <div class="field">
                    <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                    <input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus />
                    <span asp-validation-for="CurrentPassword" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="NewPassword">Mật khẩu mới</label>
                    <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                    <span class="hint">Ít nhất 8 ký tự, có cả chữ và số. Các thiết bị khác sẽ bị đăng xuất.</span>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
                <button class="btn btn--block" type="submit">Đổi mật khẩu</button>
            </form>
        </div>
    </div>
</div>
