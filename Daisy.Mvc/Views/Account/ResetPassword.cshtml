@model ResetPasswordForm

<div class="wrap">
    <div class="auth">
        <div class="panel stack" style="--stack:20px">
            <h1 style="font-size:var(--fs-2xl);margin:0">Đặt mật khẩu mới</h1>
            @if (string.IsNullOrEmpty(Model.Token))
            {
                <p class="flash flash--bad" style="margin:0">Liên kết không đầy đủ. Hãy mở lại liên kết trong email hoặc yêu cầu liên kết mới.</p>
                <a href="/account/forgot-password">Yêu cầu liên kết mới</a>
            }
            else
            {
                <form method="post" action="/account/reset-password" asp-antiforgery="true" class="stack" style="--stack:16px" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <input type="hidden" asp-for="Token" />
                    <div class="field">
                        <label asp-for="NewPassword">Mật khẩu mới</label>
                        <input asp-for="NewPassword" type="password" autocomplete="new-password" autofocus />
                        <span class="hint">Ít nhất 8 ký tự, có cả chữ và số.</span>
                        <span asp-validation-for="NewPassword" class="field-error"></span>
                    </div>
                    <div class="field">
                        <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                    </div>
                    <button class="btn btn--block" type="submit">Lưu mật khẩu mới</button>
                </form>
            }
        </div>
    </div>
</div>
