@model ForgotPasswordForm

<div class="wrap">
    <div class="auth">
        <div class="panel stack" style="--stack:20px">
            <h1 style="font-size:var(--fs-2xl);margin:0">Quên mật khẩu</h1>
            @if (ViewData["Sent"] is true)
            {
                <p class="flash flash--good" style="margin:0">Nếu email này đã đăng ký, chúng tôi vừa gửi liên kết đặt lại mật khẩu. Liên kết có hiệu lực trong 30 phút.</p>
                <a href="/account/login">Quay lại đăng nhập</a>
            }
            else
            {
                <p class="muted" style="margin:0">Nhập email bạn dùng để đăng ký. Chúng tôi sẽ gửi liên kết để đặt mật khẩu mới.</p>
                <form method="post" action="/account/forgot-password" asp-antiforgery="true" class="stack" style="--stack:16px" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors"></div>
                    <div class="field">
                        <label asp-for="Email">Email</label>
                        <input asp-for="Email" type="email" autocomplete="email" autofocus />
                        <span asp-validation-for="Email" class="field-error"></span>
                    </div>
                    <button class="btn btn--block" type="submit">Gửi liên kết</button>
                </form>
            }
        </div>
    </div>
</div>
