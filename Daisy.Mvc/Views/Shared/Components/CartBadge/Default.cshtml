@model int
<a class="icon-link" href="/cart" aria-label="Giỏ hàng, @Model sản phẩm">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 7h12l-1 13H7L6 7Z" /><path d="M9 7a3 3 0 0 1 6 0" /></svg>
    <span class="label">Giỏ hàng</span>
    @if (Model > 0)
    {
        <span class="badge num">@Model</span>
    }
</a>
